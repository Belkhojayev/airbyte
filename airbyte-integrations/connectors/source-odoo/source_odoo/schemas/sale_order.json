{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "id": {
        "type": ["number"]
      },
      "display_name": {
        "type": ["null", "string"]
      },
      "partner_id": {
        "type": ["null", "array"],
        "items": [
          {"type": "number"},
          {"type": "string"}
        ]
      },
      "invoice_ids": {
        "type": ["null", "array"],
        "items": {"type": "number"}
      },
      "order_line": {
        "type": ["null", "array"],
        "items":{
          "type": ["number"]
        }
      },
      "hubspot_id": {
        "type": ["null", "number", "boolean", "string"]
      },
      "create_date": {
        "type": ["null", "string"],
        "format": "date-time"
      },
      "write_date": {
        "type": ["null", "string"],
        "format": "date-time"
      }
    }
}